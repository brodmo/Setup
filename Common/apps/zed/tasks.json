[
  {
    "label": "Typst Preview",
    "command": "tinymist",
    "args": ["preview", "main.typ"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "allow_concurrent_runs": false
  },
  {
    "label": "lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hide": "on_success",
    "reveal_target": "center",
    "show_summary": false,
    "show_command": false,
    "allow_concurrent_runs": false
  }
]

