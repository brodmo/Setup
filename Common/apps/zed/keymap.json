[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-s": "project_panel::ToggleFocus",
      "cmd-t": "terminal_panel::ToggleFocus",
      "cmd-r": "agent::ToggleFocus",
      // focus center pane with cmd-e
      // close panes with cmd-w
      "cmd-shift-t": "project_symbols::Toggle", // shadowed by terminal
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "<": ["workspace::SendKeystrokes", "< g v"],
      ">": ["workspace::SendKeystrokes", "> g v"],
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g l": ["task::Spawn", { "task_name": "lazygit" }],
      "h": ["workspace::SendKeystrokes", "ctrl-o"],
      "j": ["workspace::SendKeystrokes", "ctrl-i"],
      "k": ["workspace::SendKeystrokes", "\" _ d d"],
      "l": "vim::FirstNonWhitespace",
    },
  },
]
